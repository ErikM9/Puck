# Port the API listens on
PORT=5000
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/puck
# Signs login tokens, so it should be long and random
JWT_SECRET=replace_this_with_a_long_random_secret
# The client's address, the only origin CORS lets in
CLIENT_ORIGIN=http://localhost:5173
# Optional: where the verification links open when the client lives under a path, CLIENT_ORIGIN when unset
# CLIENT_URL=https://erikm9.github.io/Puck
# Gmail address and 16-character App Password for the verification and recovery emails
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
# Optional: requests per IP per 15 minutes on /auth, 20 when unset
# AUTH_RATE_LIMIT_MAX=20
# Optional: set to 1 to run without sending any email, which also lets new accounts skip verification
# EMAIL_DISABLED=1
# Optional: set to 1 behind a reverse proxy, so the rate limiter sees each caller's own address
# TRUST_PROXY=1