{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    /* Named outright, so only the @types packages listed here are loaded */
    "types": ["node"],
    "outDir": "./node_modules/.tmp/e2e"
  },
  /* The browser suite sits outside src, so without its own project it goes unchecked */
  "include": ["e2e", "playwright.config.ts"]
}